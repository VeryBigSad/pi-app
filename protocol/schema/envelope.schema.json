{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://verybigsad.github.io/pi-mobile/schema/envelope-v1.json",
  "title": "Pi Mobile protocol v1 JSON envelope",
  "type": "object",
  "x-maxJsonBytes": 262144,
  "required": ["v", "type", "messageId", "replyTo", "body"],
  "properties": {
    "v": {"$ref": "#/$defs/version"},
    "type": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"
    },
    "messageId": {"$ref": "#/$defs/uuidV4"},
    "replyTo": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/uuidV4"}
      ]
    },
    "body": {"type": "object"}
  },
  "additionalProperties": true,
  "$defs": {
    "version": {
      "type": "object",
      "required": ["major", "minor"],
      "properties": {
        "major": {"const": 1},
        "minor": {"type": "integer", "minimum": 0, "maximum": 255}
      },
      "additionalProperties": true
    },
    "uuidV4": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "uint64": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,19})$",
      "format": "uint64"
    },
    "leafId": {
      "oneOf": [
        {"type": "null"},
        {"type": "string", "pattern": "^[0-9a-f]{8}$"}
      ]
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
