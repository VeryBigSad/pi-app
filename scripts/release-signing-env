#!/usr/bin/env bash
set -euo pipefail
path="$HOME/Library/Application Support/PiMobile/signing/release.jks"
password=$(security find-generic-password -a "$USER" -s io.github.verybigsad.pimobile.signing -w)
printf 'export PI_MOBILE_KEYSTORE_PATH=%q\n' "$path"
printf 'export PI_MOBILE_KEYSTORE_PASSWORD=%q\n' "$password"
printf 'export PI_MOBILE_KEY_PASSWORD=%q\n' "$password"
