{
  "name": "pi-mobile",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.2 <23",
    "npm": ">=10.9.8 <11"
  },
  "packageManager": "npm@10.9.8",
  "workspaces": [
    "protocol/ts",
    "protocol/tools",
    "mac/host",
    "mac/approval",
    "mac/preload",
    "mac/pi-patch",
    "mac/compatibility"
  ],
  "scripts": {
    "build": "npm run terminal:build && tsc -b && npm run build --workspaces --if-present",
    "terminal:build": "node scripts/build-terminal.mjs",
    "terminal:verify": "node scripts/build-terminal.mjs && git diff --exit-code -- android/terminal/src/main/assets/terminal android/terminal/web/asset-manifest.json",
    "check": "npm run lint && npm run typecheck && npm test",
    "identity:verify": "node scripts/verify-release-identity.mjs",
    "fixtures:generate": "npm run generate --workspace @pimobile/protocol-tools",
    "dal:verify": "node scripts/verify-dal.mjs",
    "fixtures:verify": "npm run verify --workspace @pimobile/protocol-tools",
    "lint": "eslint .",
    "pi:smoke": "tsx mac/host/src/smoke-pi.ts",
    "pi:smoke:daemon": "tsx mac/host/src/smoke-daemon.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc -b"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "22.20.1",
    "@types/qrcode": "1.5.6",
    "@vitest/coverage-v8": "4.1.10",
    "@xterm/xterm": "6.1.0-beta.292",
    "esbuild": "0.28.2",
    "eslint": "10.8.1",
    "fast-check": "4.9.0",
    "tsx": "4.23.11",
    "typescript": "6.0.3",
    "typescript-eslint": "8.66.0",
    "vitest": "4.1.10"
  }
}
