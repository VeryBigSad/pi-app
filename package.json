{
  "name": "pi-mobile",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.2 <23",
    "npm": ">=10.9.8 <11"
  },
  "packageManager": "npm@10.9.8",
  "workspaces": [
    "protocol/ts",
    "protocol/tools",
    "mac/host",
    "mac/approval",
    "mac/preload",
    "mac/pi-patch",
    "mac/compatibility"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "check": "npm run lint && npm run typecheck && npm test",
    "fixtures:generate": "npm run generate --workspace @pimobile/protocol-tools",
    "fixtures:verify": "npm run verify --workspace @pimobile/protocol-tools",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc -b"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.1",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "10.8.1",
    "fast-check": "4.9.0",
    "tsx": "4.23.11",
    "typescript": "6.0.3",
    "typescript-eslint": "8.66.0",
    "vitest": "4.1.10"
  }
}
